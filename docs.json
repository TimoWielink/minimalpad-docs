{
  "$schema": "https://mintlify.com/docs.json",
  "name": "MinimalPad",
  "description": "Build, connect, configure, and troubleshoot your MinimalPad with clear step-by-step guides.",
  "theme": "mint",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "colors": {
    "primary": "#2d2d2d",
    "light": "#a3a3a3",
    "dark": "#737373"
  },
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "navbar": {
    "links": [
      {
        "label": "Shop",
        "href": "https://www.minimalmacropad.com/"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/TimoWielink/zmk-config-minimalpad"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Studio",
      "href": "https://studio.minimalmacropad.com/"
    }
  },
  "topbar": {
    "style": "default"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/TimoWielink/zmk-config-minimalpad"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "icon": "sparkles",
        "pages": [
          "getting-started/welcome",
          "getting-started/quick-start",
          "getting-started/choose-your-minimalpad",
          "getting-started/before-you-begin",
          "getting-started/hardware-overview"
        ]
      },
      {
        "group": "Connect",
        "icon": "plug",
        "pages": [
          "connecting/connect-usb",
          "connecting/connect-bluetooth",
          "connecting/connection-status"
        ]
      },
      {
        "group": "Configure with Studio",
        "icon": "sliders",
        "pages": [
          "studio/overview",
          "studio/inspect-keymap",
          "studio/change-a-key",
          "studio/save-discard-disconnect",
          "studio/limitations"
        ]
      },
      {
        "group": "Keys, layers, and actions",
        "icon": "layer-group",
        "pages": [
          "studio/single-key",
          "studio/shortcuts",
          "studio/media-controls",
          "studio/layers",
          "studio/bluetooth-actions",
          "studio/rgb-actions",
          "studio/encoder"
        ]
      },
      {
        "group": "Firmware",
        "icon": "microchip",
        "pages": [
          "firmware/firmware-and-studio",
          "firmware/install-base-firmware",
          "firmware/build-with-github-actions",
          "firmware/advanced-customization",
          "firmware/recover"
        ]
      },
      {
        "group": "Get help",
        "icon": "life-ring",
        "pages": [
          "troubleshooting/studio-cannot-find",
          "troubleshooting/bluetooth-problems",
          "troubleshooting/changes-not-saved",
          "troubleshooting/flashing-problems",
          "troubleshooting/faq"
        ]
      }
    ]
  }
}
